# Supabase — from https://supabase.com/dashboard/project/_/settings/api
# The anon key is safe to expose in the browser; row-level security enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — shared rate limiting across serverless instances (free tier at upstash.com).
# Without these, limits are enforced in memory per instance and reset on deploy.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
