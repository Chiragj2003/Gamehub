# Supabase — from https://supabase.com/dashboard/project/_/settings/api
# The anon key is safe to expose in the browser; row-level security enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — shared rate limiting across serverless instances (free tier at upstash.com).
# Without these, limits are enforced in memory per instance and reset on deploy.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Optional — show "Continue with Google" once the provider is enabled in
# Supabase → Authentication → Providers.
# NEXT_PUBLIC_AUTH_GOOGLE=1

# Required for self-serve account deletion (server-only; never exposed to the browser).
# Supabase → Project Settings → API → service_role key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical URL for sitemaps and social cards. Defaults to the Vercel production
# hostname; set this once you attach a custom domain.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
